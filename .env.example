# ---- Supabase ----
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- アプリのURL ----
# Square の戻り先URLと Webhook の署名検証に使うため、本番では必ず実際のドメインを設定してください。
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- Square ----
# sandbox / production を切り替えます。まずは sandbox で動作確認してください。
SQUARE_ENVIRONMENT=sandbox
# Square 開発者ダッシュボード > アプリケーション > Credentials のアクセストークン
SQUARE_ACCESS_TOKEN=your-square-access-token
# Square 開発者ダッシュボード > Locations の店舗ID
SQUARE_LOCATION_ID=your-square-location-id
# Webhook サブスクリプション作成時に発行される署名キー
SQUARE_WEBHOOK_SIGNATURE_KEY=your-square-webhook-signature-key
